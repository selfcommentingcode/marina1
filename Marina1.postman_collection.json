        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Harbor Point Marina\",\n  \"location\": \"Lake Union, Seattle\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/marinas",
          "host": ["{{baseUrl}}"],
          "path": ["marinas"]
